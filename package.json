{
  "name": "containment-depth",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "capture": "node scripts/nextgen/capture.mjs",
    "build": "tsc --noEmit && vite build",
    "playtest": "node scripts/nextgen/playtest/runner.mjs",
    "playtest:sim": "node scripts/nextgen/playtest/sim.mjs",
    "playtest:smoke": "node scripts/nextgen/playtest/runner.mjs --rig=arc --seed=1729 --rooms=3 --label=smoke --max-wall-seconds=235",
    "bench": "node scripts/nextgen/bench.mjs",
    "bench:rooms": "node scripts/nextgen/bench-rooms.mjs",
    "verify": "npm run build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.183.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "1.58.2",
    "typescript": "6.0.3",
    "vite": "8.1.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
